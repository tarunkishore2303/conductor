### Generate a real workflow proposal; no persistence as workflow or execution yet
# @name generateRealWorkflow
POST {{baseUrl}}/api/v1/ai/workflows/generate
Content-Type: application/json

{"prompt":"Create four sequential tasks: HTTP GET http://task-demo:8080/orders with timeoutMillis 2000; DELAY 100ms; TRANSFORM JSON_SELECT id from static input {\"id\":42,\"internal\":\"omit\"}; HTTP POST http://task-demo:8080/notify with application/json body {\"status\":\"READY\"} and timeoutMillis 2000. Use maxRetries 1. Do not use NOOP."}

### Inspect the proposal's workflow and validation before approving
GET {{baseUrl}}/api/v1/ai/workflows/proposals/{{generateRealWorkflow.response.body.$.proposalId}}

### Explicit approval (does not execute)
# @name approveRealWorkflow
POST {{baseUrl}}/api/v1/ai/workflows/proposals/{{generateRealWorkflow.response.body.$.proposalId}}/approve
Content-Type: application/json

{}

### Separate execution of the approved workflow
POST {{baseUrl}}/api/v1/workflows/{{approveRealWorkflow.response.body.$.id}}/jobs
Content-Type: application/json

{"name":"AI proposed real workflow, human-approved execution"}

### Optimization: analyze the real template after several separate executions
# Repeat "Execute separately" at least five times and wait for each run to settle.
# Only template jobs created after the identity migration contribute; old runs are not guessed.
# @name generateOptimization
POST {{baseUrl}}/api/v1/ai/workflows/{{createRealWorkflow.response.body.$.id}}/optimization

### Read stored advisory report (works without Ollama)
GET {{baseUrl}}/api/v1/ai/workflows/{{createRealWorkflow.response.body.$.id}}/optimization

### Repeat unchanged evidence: same optimizationId/contextHash, no extra model call
POST {{baseUrl}}/api/v1/ai/workflows/{{createRealWorkflow.response.body.$.id}}/optimization

