# Optional AI profile uses a local Ollama container, not a cloud provider.
AI_ENABLED=true
AI_MODEL=qwen2.5-coder:7b
OLLAMA_BASE_URL=http://ollama:11434
AI_REQUEST_TIMEOUT=120s
# API must wait longer than the bounded model request.
AI_SERVICE_TIMEOUT=130s
# Opt-in fixed demo failures; ordinary tasks remain NOOP.
DEMO_FAILURES_ENABLED=false
