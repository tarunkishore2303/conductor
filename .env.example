# Optional AI profile uses a local Ollama container, not a cloud provider.
AI_ENABLED=true
AI_MODEL=qwen2.5-coder:7b
AI_EMBEDDING_MODEL=nomic-embed-text:v1.5
AI_INCIDENT_MIN_SIMILARITY=0.93
OLLAMA_BASE_URL=http://ollama:11434
AI_REQUEST_TIMEOUT=120s
# Serialized failure-context JSON characters, not model tokens; shared by API and AI.
AI_FAILURE_CONTEXT_MAX_CHARS=32768
# API must wait longer than the bounded model request.
AI_SERVICE_TIMEOUT=130s
# Entire copilot request deadline across model steps and read tools.
AI_COPILOT_TIMEOUT=180s
# Opt-in fixed demo failures; NOOP tasks otherwise succeed normally.
DEMO_FAILURES_ENABLED=false

# Demo only: enables private/loopback HTTP task targets across API, AI and workers.
TASK_HTTP_ALLOW_PRIVATE_ADDRESSES=false
# Successful-attempt text output ceiling in UTF-8 bytes; 1..65536, shared across API/AI/workers.
TASK_OUTPUT_MAX_BYTES=65536

# Fixed demo HTTP fixture only: 500 exercises notification retry/DLQ; restore 200 afterward.
TASK_DEMO_NOTIFICATION_STATUS=200

# Bounded advisory history (API-owned); minimum sample size must not exceed max runs.
OPTIMIZATION_MAX_RUNS=50
OPTIMIZATION_MIN_SAMPLE_SIZE=5
OPTIMIZATION_MAX_CANDIDATES=20
OPTIMIZATION_HISTORY_WINDOW=30d
OPTIMIZATION_MAX_ATTEMPTS=1000
